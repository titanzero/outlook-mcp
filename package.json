{
  "name": "outlook-mcp",
  "version": "1.0.0",
  "description": "MCP server for Claude to access Outlook data via Microsoft Graph API",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "auth-server": "node outlook-auth-server.js",
    "inspect": "npx @modelcontextprotocol/inspector --web node index.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "debug": "node scripts/debug-env.js",
    "find-folders": "node scripts/find-folder-ids.js",
    "move-github": "node scripts/move-github-emails.js",
    "create-rules": "node scripts/create-notifications-rule.js"
  },
  "keywords": [
    "claude",
    "outlook",
    "mcp",
    "microsoft-graph",
    "email"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@microsoft/microsoft-graph-client": "^3.1.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@toon-format/toon": "^4.4.0",
    "dotenv": "^18.0.10"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@microsoft/microsoft-graph-types": "^2.43.1",
    "@modelcontextprotocol/inspector": "^2.13.0",
    "eslint": "^10.15.0",
    "jest": "^30.5.2",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
